{
  "extends": "@synclyft/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@synclyft/lib": ["../../packages/lib/src/index.ts"],
      "@synclyft/lib/*": ["../../packages/lib/src/*"],
      "@synclyft/ui": ["../../packages/ui/src/index.ts"],
      "@synclyft/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/lib/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
