{
  "name": "synclyft-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:student": "turbo run dev --filter=@synclyft/student",
    "dev:officer": "turbo run dev --filter=@synclyft/officer",
    "dev:admin": "turbo run dev --filter=@synclyft/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "turbo": "^2.5.8",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  }
}
