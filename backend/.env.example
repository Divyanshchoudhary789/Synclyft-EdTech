# ─────────────────────────────────────────────────────────────
# Synclyft EdTech — Backend environment
# Copy to .env and fill in. Names here match exactly what the code reads.
# ─────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=production
PORT=8080
BACKEND_URL=https://api.synclyft.example
FRONTEND_URL=https://student.synclyft.example
# Comma-separated — MUST list every deployed frontend origin (student/officer/admin)
CORS_ALLOWED_ORIGINS=https://student.synclyft.example,https://officer.synclyft.example,https://admin.synclyft.example

# ── Database (note: URL, not URI) ──
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/synclyft?retryWrites=true&w=majority
# Auxiliary DBs used by the interview engine (defaults shown)
CODING_DB_NAME=Synclyft-EdTech
APTITUDE_DB_NAME=aptitude_platform

# ── Auth ──
JWT_SECRET=generate_64_random_hex_chars_min_32
SESSION_SECRET=generate_another_64_random_hex_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Redis (Upstash — rediss:// TLS required in prod) ──
REDIS_URL=rediss://default:token@your-db.upstash.io:6379

# ── Cloudflare R2 (S3-compatible) ──
ACCOUNT_ID=your_cloudflare_account_id
ACCESS_KEY_ID=your_r2_access_key
SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=synclyft-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=ghp_xxx   # for GitHub coding-profile sync
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Email (SMTP) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@synclyft.example
MAIL_REPLY_TO=support@synclyft.example
EMAIL_PROCESSOR_DISABLED=false

# ── Payments (Razorpay) ──
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TAX_RATE=0   # 0.18 for 18% GST

# ── AI / models ──
GEMINI_API_KEY=
INITIALIZE_APTITUDE_ROUND_URL=https://ed-tech-aptitude-round.example/start-session
APTITUDE_QUESTIONS_URL=https://ed-tech-aptitude-round.example/fetch-questions
APTITUDE_API_KEY=
CODING_QUESTIONS_BATCH_URL=https://coding-round-model.example/v1/recommend-batch
CODING_QUESTIONS_BATCH_TOKEN=
TECHNICAL_QUESTION_URL=https://coding-round-model.example/v1/recommend
TECHNICAL_QUESTION_TOKEN=

# ── Judge0 (self-hosted — see docs/production-readiness / Oracle VM setup) ──
JUDGE0_URL=https://judge0.synclyft.example
JUDGE0_AUTH_TOKEN=   # matches AUTHN_TOKEN in judge0.conf

# ── Voice interview (technical + HR rounds) ──
DEEPGRAM_API_KEY=
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_TECHNICAL_FACE_ID=

# ── Observability ──
LOGTAIL_SOURCE_TOKEN=
SENTRY_DSN=          # optional; error tracking (no-op when empty)
LOG_LEVEL=warn       # debug in dev
# GIT_COMMIT / RENDER_GIT_COMMIT are auto-set by the platform for Sentry release tagging
